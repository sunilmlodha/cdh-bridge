{
  "name": "cdh-bridge-demos",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/web", "destination": "/web/index.html" },
    { "source": "/mobile", "destination": "/mobile/index.html" },
    { "source": "/citadele", "destination": "/citadele/index.html" },
    { "source": "/citadele/web", "destination": "/citadele/web/index.html" },
    { "source": "/citadele/mobile", "destination": "/citadele/mobile/index.html" },
    { "source": "/cookbook", "destination": "/cookbook.html" },
    { "source": "/cookbook/print", "destination": "/cookbook-print.html" }
  ]
}
