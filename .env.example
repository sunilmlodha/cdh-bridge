# =============================================================================
# CDH Bridge — Environment Variables
# Copy this file to .env and fill in the real values before running locally.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Pega CDH Gateway
# In production replace mock-cdh with the real Pega CDH REST gateway URL.
# -----------------------------------------------------------------------------
PEGA_CDH_URL=http://mock-cdh:3010
PEGA_CDH_AUTH_TOKEN=dev-token-replace-in-prod

# Pega CDH request timeout in milliseconds (default: 10000)
PEGA_CDH_TIMEOUT=10000

# Number of retries on transient Pega CDH errors (default: 3)
PEGA_CDH_RETRIES=3

# -----------------------------------------------------------------------------
# Kafka
# Comma-separated list of broker addresses (host:port)
# -----------------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092

# Optional: override the KafkaJS client ID (useful for multi-tenant setups)
KAFKA_CLIENT_ID=cdh-bridge

# Number of partitions to create for each CDH topic (default: 3)
KAFKA_PARTITIONS=3

# Replication factor for each CDH topic (default: 1 for local dev, ≥2 for prod)
KAFKA_REPLICATION_FACTOR=1

# -----------------------------------------------------------------------------
# Redis
# Full ioredis-compatible URL. Use rediss:// for TLS-enabled Redis (prod).
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# JWT / Auth (used by event-collector to validate inbound SDK tokens)
# -----------------------------------------------------------------------------
JWT_SECRET=dev-secret-replace-in-prod

# -----------------------------------------------------------------------------
# General application settings
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Per-service ports
# Each service reads the PORT variable — override per service in docker-compose
# or set here as a default for local bare-metal runs.
# -----------------------------------------------------------------------------

# event-collector
PORT=3001

# profile-router uses 3002, feedback-loop 3003, consent-service 3004,
# connector-service 3005, mock-cdh 3010, dashboard 3000.
# Override by setting PORT in the relevant service's environment block.

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins for event-collector CORS middleware.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
